{
    "name": "flexihash/flexihash",
    "type": "library",
    "description": "Flexihash is a small PHP library which implements consistent hashing",
    "keywords": ["hashing", "consistent-hashing", "consistent", "hash", "distributed", "caching"],
    "homepage": "https://github.com/pda/flexihash",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul Annesley",
            "email": "paul@annesley.cc",
            "homepage": "https://paul.annesley.cc"
        },
        {
            "name": "Dom Morgan",
            "email": "dom@d3r.com",
            "homepage": "https://d3r.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Flexihash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flexihash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "benchmark": "phpunit --group benchmark tests/BenchmarkTest.php",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --no-progress",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit test suite",
        "benchmark": "Run the benchmark suite",
        "cs": "Check coding standards (PSR-12)",
        "cs:fix": "Fix coding standard violations",
        "stan": "Run static analysis",
        "check": "Run all checks (coding standards, static analysis, tests)"
    },
    "config": {
        "sort-packages": true
    }
}
