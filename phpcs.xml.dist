<?xml version="1.0"?>
<ruleset name="Flexihash">
    <description>Flexihash Coding Standard</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>
</ruleset>
